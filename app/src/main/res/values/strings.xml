    <string name="collection_unknown">？？？</string>
    <string name="collection_hint_harvest">そだてて　しゅうかく すると　とうろく される。</string>
    <string name="collection_hint_placement">にわに　おくと　とうろく される。</string>
    <string name="flavor_cosmos">あきかぜに　ゆれる　うすべにの はな。\nほそい くきでも　かぜに まけない。</string>
    <string name="flavor_snowdrop">ゆきの したから　かおを だす。\nしろい すずは　はるを まつ あいず。</string>
    <string name="flavor_tomato">なつの ひざしで　まっかに みのる。\nのどが かわきやすいので　みずやりは こまめに。</string>
    <string name="flavor_strawberry">はるの ひだまりで　あかく ふくらむ。\nちいさくても　あまい かおりで いっぱい。</string>
    <string name="flavor_watermelon">つるを のばして　まんまるに そだつ。\nなつの おひさまと　たっぷりの みずが すき。</string>
    <string name="flavor_lavender">むらさきの ほが　かぜに ゆれる。\nきせつを とわず　やさしい かおりを とどける。</string>
    <string name="flavor_pumpkin">あきの はたけの　おおもの。\nじっくり そだてて　ずっしり おもい。</string>
    <string name="flavor_poinsettia">ふゆを いろどる　まっかな はっぱ。\nさむい ひでも　にわを あたたかく みせる。</string>
    <string name="flavor_paprika">つやつやの　あかい み。\nひとつ とっても　またつぎが　ふくらんでくる。</string>
    <string name="flavor_daikon">つちの なかで　しろく ふとる。\nさむく なるほど　あまみが ます。</string>
    <string name="flavor_mint">きせつを えらばない　つよい はっぱ。\nふれると　すっと すずしい かおりが する。</string>
    <string name="flavor_greenhouse">ガラスの なかは　いつも ぽかぽか。\nきせつはずれの はなも　ここなら そだつ。</string>
    <string name="flavor_tulip">はるの にわの　ていばん。\nそだてやすく　はじめての ひとにも やさしい。</string>
    <string name="flavor_sunflower">おひさまを　おいかけて　せを のばす。\nのどが かわきやすいので　みずやりは こまめに。</string>
    <string name="flavor_rose">はなの じょおう。\nてまは かかるが　さいたときの よろこびは ひとしお。</string>
    <string name="flavor_grass">ふかふかの　みどりの じゅうたん。\nねころぶと　きもちいい。</string>
    <string name="flavor_pebble">かわらで ひろった　まるい こいし。\nならべると　こみちに なる。</string>
    <string name="flavor_flowers">なまえも しらない　ちいさな はな。\nかぜが ふくと　いっせいに ゆれる。</string>
    <string name="flavor_deck">きの かおりが する　いたばりの ゆか。\nはだしで あるくと　きもちいい。</string>
    <string name="flavor_bench">ひとやすみに　ちょうど いい。\nすわって にわを ながめよう。</string>
    <string name="flavor_lantern">こけむした　いしの あかり。\nゆうぐれに　ぽっと ともる。</string>
    <string name="flavor_rock">どっしり かまえた　おおきな いわ。\nにわの　ぬしの ような かお。</string>
    <string name="flavor_river">さらさら ながれる　ちいさな おがわ。\nならべて つなげば　にわに せせらぎが うまれる。</string>
    <string name="flavor_path">まるい いしを　しきつめた こみち。\nあめの ひも　あしもとが ぬかるまない。</string>
    <string name="flavor_fence">きを くんだ　そぼくな さく。\nはなばたけを　ぐるりと かこもう。</string>
    <string name="flavor_well">つめたい みずが　こんこんと わく。\nのぞきこむと　じぶんの かおが ゆれる。</string>
    <string name="flavor_windmill">かぜを うけて　くるり くるり。\nはねの まわる おとが　にわに ひびく。</string>
    <string name="flavor_hut">ちいさいけれど　ゆめの つまった こや。\nどうぐも　ひるねも　ここで。</string>
    <string name="flavor_cottage">にわの　まんなかに　たつ　あかりの いえ。\nえんとつから　けむりが　のぼると　にわが ひろがる。</string>
